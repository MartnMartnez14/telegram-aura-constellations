# ============================================================================
# Telegram AURA — Constellations (Configuración Opcional de Backend TMA)
# ============================================================================
# La aplicación web funciona 100% local-first sin necesidad de servidor.
# Si deseas activar el backend opcional FastAPI para validar firmas HMAC-SHA256
# de Telegram Mini Apps y recibir mensajes enviados voluntariamente a un Bot:

TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token
AURA_SQLITE_PATH=aura_tma.sqlite3
AURA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
